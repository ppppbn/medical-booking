# Database
DATABASE_URL="sqlserver://localhost:1433;database=med_booking;user=sa;password=your_password;encrypt=true;trustServerCertificate=true"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here-change-in-production"
JWT_EXPIRES_IN="7d"

# Server & CORS
PORT=8080
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# Email Configuration (Nodemailer - Gmail)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-gmail-app-password"

# VNPay Payment Configuration
VNP_TMNCODE="YOUR_VNPAY_TMNCODE"
VNP_HASHSECRET="YOUR_VNPAY_HASHSECRET"
VNP_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNP_RETURNURL="http://localhost:3000/payment/vnpay-return"
